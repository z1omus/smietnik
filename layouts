@Composable
fun RowBasics(){
    Column(){
        Text("Row- podstawy", style=MaterialTheme.typography.titleLarge)
    }
    Row(modifier = Modifier.fillMaxWidth()
        .background(Color(0xFF798FD3))
        .padding(12.dp),
        horizontalArrangement = Arrangement.SpaceAround,
        verticalAlignment = Alignment.Top
    ){
        Text("left", modifier= Modifier.align(Alignment.Bottom))
        Text("center")
        Text("right")
    }
    Row(
        modifier = Modifier.fillMaxWidth()
            .background(Color(0xFFDC75F5))
    ) {

        Text("bottom", modifier= Modifier.align(Alignment.Bottom))
        Text("top", fontSize = 30.sp)

    }
}
