        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="800" 
        d:DesignHeight="800"
        x:Class="szpontrerzy2.MainWindow"
        Title="szpontrerzy2">
        <StackPanel Margin="10">
                <Button
                        Content="Kliknij mnie"
                        Width="200"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                />
                <Button
                        Content="Drugi do kliknięcia"
                        Width="300"
                        Background="LightBlue"
                        Foreground="CornflowerBlue"
                        FontSize="30"
                        />
                <TextBlock
                        Text="Text dla szpontów"
                        Margin="20"
                        Padding="20"
                        />
                <TextBlock
                        Text="To jest jakis tekst"
                        Margin="20"
                        Padding="20"
                        Foreground="DarkMagenta"
                        Background="Violet"
                        TextAlignment="Center"
                        />
                <TextBox
                        Width="300"
                        Height="50"
                        Watermark="napisz swoje imię"
                        Margin="20, 30, 40, 50"
                        />
                <TextBox
                        Width="200"
                        FontSize="16"
                        Foreground="DarkCyan"
                        CornerRadius="20"
                        Background="CadetBlue"
                        BorderBrush="DarkCyan"
                        BorderThickness="10"
                        />
                <CheckBox
                        Content="Akceptuje warunki umowy"
                        />
                <CheckBox
                        Content="Zgadzam sie na kupowanie kebabów dla całej grupy"
                        FontSize="16"
                        FontWeight="Solid"
                        Foreground="HotPink"
                        Padding="15,15,0,10"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        
                        />
                <StackPanel Orientation="Horizontal">
                        <RadioButton Content="pizza"
                                     GroupName="meal"
                                />
                        <RadioButton Content="kebab"
                                     GroupName="meal"
                        />
                        <RadioButton Content="Zapiekanka"
                                     GroupName="meal"
                                />
                </StackPanel>
                <StackPanel>
                        <RadioButton Content="cola"
                                     GroupName="drink"
                        />
                        <RadioButton Content="woda"
                                     GroupName="drink"
                        />
                        <RadioButton Content="pepsi"
                                     GroupName="drink"
                        />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox Width="200" Margin="20">
                                <ComboBoxItem Content="Ostry meksykanski"/>
                                <ComboBoxItem Content="Łagodny wyspiarski"/>
                                <ComboBoxItem Content="Szefowsko-szponterski"/>
                        </ComboBox>
                        
                        <ComboBox SelectedIndex="1" 
                                Width="200" 
                                Margin="20">
                                <ComboBoxItem Content="klient VIP"/>
                                <ComboBoxItem Content="zwykły klient"/>
                                <ComboBoxItem Content="klient Szefa"/>
                        </ComboBox>
                </StackPanel>
        </StackPanel>
</Window>
