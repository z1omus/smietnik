interface HasSummary{
    getSummary(): string;
}
class Book implements HasSummary{
    constructor(
        public title: string,
        public author: string,
        public pages: number
    ){}
    getSummary(): string {
        return `${this.title} by ${this.author} has ${this.pages} pages`;
    }
}
const zbrodniaIKara = new Book("Zbrodnia i kara", "Dostojewski", 263)
console.log(zbrodniaIKara.getSummary());

