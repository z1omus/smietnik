//klasa abstrakcyjna- klasa, która nie może mieć obiektów
abstract class Figura{
    abstract obliczPole():number
}
class Kolo extends Figura{
    constructor(private promien: number){
        super();
    }
    obliczPole(): number{
        return Math.PI * this.promien **2;
    }
}
const kolo = new Kolo(5)
console.log(`${kolo.obliczPole().toFixed(2)}`)


