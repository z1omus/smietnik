type User = {
    id: number;
    name: string;
    role: "user" | "admin";
}
//łączenie typów name: string|int
const users: User[] = [
    {id: 1, name: "Jakub", role: "user"},
    {id: 2, name: "Kenya", role: "admin"},
    {id: 3, name: "Sam", role: "admin"},
]

const hasAdmin: boolean = users.some(u => u.role==="admin");
console.log(hasAdmin);
/////////////////////////////////////EVERY()
//sprawdza czy każdy element listy spełnia warunek
const hasAdmin: boolean = users.every(u => u.role==="admin");
console.log(hasAdmin);
////////////////////////////////////REDUCE()
//redukuje wszystkie elementy do jednej wartości

const prices: number[] = [100, 50, 25]

const total: number = prices.reduce((acc, price)=>acc+price, 0)
console.log(total)
/*
lista.reduce((acc, jakas_nazwa_o_redukowanej_liście)=>jakies działanie do acc, inicjowana_wartosc_na_poczatku)
initialValue=0 , czyli akumulator przyjmuje wartość 0 początkowo

działanie
acc = 0, price=100 => acc=100
acc = 100, price=50 => acc=150
acc = 150, price=25 => acc=175
 */
 
