///////////////////////////////////LibraryItem.kt
package com.example.mylibrary

abstract class LibraryItem (
    val title: String,
    val year: Int
){
    abstract fun info(): String
}
/////////////////////////////////Borrowable.kt - kotlin interface
package com.example.mylibrary

interface Borrowable {
    fun borrow()
    fun returnItem()
}
