type User={
    id:number;
    name: string;
    active: boolean;
}
const users: User[]=[
    {id:1, name:"John", active:false},
    {id:2, name:"Alice", active:true},
    {id:3, name:"Bob", active:false},
]
function saveUserToApi(user: User){
    console.log(`saving user ${user.name} with id ${user.id}...`)
}
users.forEach(user => {
    if(user.active){
        saveUserToApi(user)
    }
    else{
        console.log(`skipping user ${user.name} with id ${user.id}...`)
    }
})
