type Item = {
    id: number,
    name: string,
    price: number,
}
const items: Item[] = [
    {id:1, name: "Srebrny miecz", price:1200},
    {id:2, name: "Eliksir jaskółki", price:200},
    {id:3, name: "Zbroja z Kaer Morhen", price:5200},
]
//margin- marża- procent po jakim sie sprzedaje od kupna
const itemsWithMargin:Item[] = items.map((item: Item)=>({...item, priceWithMargin: item.price *1.2}))
// ... bierze pojedynczy z rekord z item, a my jeszcze dodajemy cene z marżą
console.log(itemsWithMargin)
