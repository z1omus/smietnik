package com.example.projekt2
////////////////////////DZIEDZICZENIE
//dziedziczenie-jedna klasa pobiera z drugiej wszystkie metody i właściwości nsa które rodzic się zgadza(trzeba napisać open)

open class Ufo(val shape: String){
    open fun fly(){
        //metody i właściwości są defaultowo final
        println("Ufo o kształcie $shape leci przez niebo")
    }
}
//otworzona klasa na dziedziczenie
class SilverUfo: Ufo(shape="dysk"){
    override fun fly() {
        println("Srebrne ufo śmiga przez chmury z prędkością światła")
    }
    fun cloak(){
        println("Srebrne ufo włączyło niewidzialność")
    }
}

open class Zwierze(val gatunek: String){
    //gatunek to właściwość
    open val dzwiek: String = "Ogólny dźwięk"

    open fun wydajDzwiek(){
        println("$gatunek wydaje dźwięk: $dzwiek")
    }
}
class Pies(gatunek: String): Zwierze(gatunek) {
//gatunek to parametr funkcji, bo nie ma val/var
    override val dzwiek: String = "Szczekanie"

    override fun wydajDzwiek(){
        println("$gatunek szczeka: $dzwiek")
    }
    fun machajOgonem(){
        println("Pies macha ogonem")
    }
}


//////////////////////////////////HERMETYZACJA
//zamykamy coś przed oddziaływaniem z zewnątrz

//jeżeli nie jest nic napisane, to jest to public, czyli z zewnątrz można się dostać i zmienić wartości
class UfoEngine{
    private var warpCoreTemperature: Int = 121
    //nikt spoza klasy się nie dostanie do zmiany wartości np.

    fun checkStatus():String{
        return if(warpCoreTemperature<120) "Warp core staabilny" else "Uwaga: przegrzanie"

    }

    fun coolDown(){
        warpCoreTemperature -= 10
        //wewnątrz klasy można zmieniać nawet jeżeli jest private
    }
    fun showThis(){
        println(this)
    }
    fun showCoreTemperature():Int{
        return this.warpCoreTemperature
        //this oznacza nazwę wskazującą na ten konkretny obiekt
    }
}
