class Participant
{
    public string Name { get; set; }
    public Participant(string name)
    {
        Name = name;
    }

    public void OnConferenceStarted()
    {
        Console.WriteLine($"{Name} jest na sali");
    }
}


class ConferenceOrganizaer
{
    public event Action ConferenceStarted;

    public void StartConference()
    {
        Console.WriteLine("Starting Conference...");
        ConferenceStarted?.Invoke();
    }

}

