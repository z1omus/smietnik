type Person ={
    name: string;
    age: number;
    job?: string;
}
function printPerson(person: Person){
    console.log(`person: ${person.name}, age: ${person.age}, job: ${person.job}`);
}
//to samo tylko, że lepiej function printPerson({name, age, job}: Person){
    console.log(`person: ${name}, age: ${age}, job: ${job}`);
}

const maciej: Person = {name: "Maciej", age: 16, job: "Uczeń"};
printPerson(maciej)


const students: Person[] = [
    {name:"Piotr", age:16},
    {name:"Dominika", age:16},
    {name:"Kenya", age:16}
]
students.forEach((s: Person) => console.log(`uczeń ${s.name}, wiek ${s.age}`));
//teraz będzie lepiej
students.forEach(({name, age}) => console.log(`uczeń ${name}, wiek ${age}`));
//w locie destrukturyzujemy
