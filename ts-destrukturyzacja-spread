type Person = {personName: string; age: number};
const person: Person = {personName: 'Bob', age: 3};
const {personName, age} = person;
//przy destrukturyzacji MUSI być nazwa identyczna z nazwą właściwości obiektu
//nie ma znaczenia kolejność, bo nie ma indexu jak w liście
console.log(personName);
console.log(age);

//let zeby mozna było zmienić wartość zmiennej personName
let {personName, age} = person;

console.log(personName);
console.log(age);
personName = 'Alice';
console.log(personName);

//jeżeli jest pootrzeba zmiany nazwy to można to zrobić po :
let {personName: imie, age: wiek} = person;
//zajrzyj do obiektu person, znajdź właściwość, która się nazywa personName i weź tą wartość do zmiennej imie
console.log(imie);
console.log(wiek);

type Person = {personName: string; age?: number};
