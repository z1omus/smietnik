class Car(val make: String, val model: String){
    var year: Int? = null
    constructor(make: String, model: String, year: Int): this(make, model){
    this.year = year
    }
    constructor(): this("brak", "brak", 100)
    fun about(){
        println("auto marki $make, model $model, z roku $year")
    }
}

