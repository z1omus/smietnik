//MainWindowTests.cs
using Avalonia.Controls;
using Avalonia.Headless.XUnit;
using Avalonia.Interactivity;
using formularzZTestem;

namespace TestProject1;

public class MainWindowTests
{
    [AvaloniaFact]
    public void Status_ShouldBeWaiting_OnStartup()
    {
        //Arrange
        var window = new MainWindow();
        
        //act
        var status= window.FindControl<TextBlock>("StatusText");
        
        //Assert
        Assert.NotNull(status);
        Assert.Equal("Oczekiwanie...", status.Text);
    }
    
    [AvaloniaFact]
    public void SubmitButton_ShouldBeEnabled_ByDefault()
    {
        var window = new MainWindow();
        var btn = window.FindControl<Button>("SubmitButton");
        Assert.NotNull(btn);
        Assert.True(btn.IsEnabled);
    }

    [AvaloniaFact]
    public void RadioButtons_ShouldMutuallyExlusive()
    {
        //arrange
        var window = new MainWindow();
        var rbtnA = window.FindControl<RadioButton>("OptionARadio");
        var rbtnB = window.FindControl<RadioButton>("OptionBRadio");
        
        Assert.NotNull(rbtnA);
        Assert.NotNull(rbtnB);
        
        rbtnA.IsChecked = true;
        
        // act
        rbtnB.IsChecked = true;
        
        // assert
        Assert.False(rbtnA.IsChecked, "zaznaczenie B powinno odznaczyć A");
        Assert.True(rbtnB.IsChecked);
    }
    
    [AvaloniaFact]
    public void UserNameInput_ShouldBeStoreProvidedText()
    {
        var window = new MainWindow();
        var nameInput = window.FindControl<TextBox>("UserNameInput");
        Assert.NotNull(nameInput);

        string testName = "Jan Kowalski";
        nameInput.Text = testName;
        Assert.Equal(testName, nameInput.Text);
    }

    [AvaloniaFact]
    public void Submit_ShouldShowError_WhenTermsNotChecked()
    {
        var window = new MainWindow();
        var nameInput = window.FindControl<TextBox>("UserNameInput");
        var terms = nameInput.FindControl<CheckBox>("TermsCheck");
        var btn = window.FindControl<Button>("SubmitButton");
        var status = window.FindControl<TextBlock>("StatusText");

        nameInput.Text = "Jan";
        terms.IsChecked = false;
        
        //act 
        btn.RaiseEvent(new RoutedEventArgs(Button.ClickEvent));//symulacja kliknięcia buttonu
        
        Assert.Equal("Błąd formularza!", nameInput.Text);
    }
}

