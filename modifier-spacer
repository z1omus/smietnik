@Composable
fun UsersInterest(modifier: Modifier = Modifier){
var notificationsEnable by remember { mutableStateOf(false)}

    val interests= remember{
        mutableStateListOf(
            Interest("Pływanie", false),
            Interest("Jazda Konna", false),
            Interest("Gra na instrumencie", false)
        )
    }
    Column(modifier = Modifier) {
        Text("Zainteresowania",
            fontSize = 40.sp,
            modifier=Modifier.padding(top=24.dp, bottom=14.dp)
            )
        interests.forEachIndexed { index, interest ->
            Row(verticalAlignment = Alignment.CenterVertically){
                Checkbox(
                    checked = interest.checked,
                    onCheckedChange = {
                        interests[index] = interest.copy(checked = it)
                    }
                )
                Text(text = interest.name)
            }
        }
        Row(){
            Text("Powiadomienia")
            Spacer(modifier = Modifier.width(12.dp))
            Switch(
                modifier = Modifier.padding(20.dp),
                checked = notificationsEnable,
                onCheckedChange = {
                    notificationsEnable = it,
                    println(notificationsEnable)
                }
            )
        }
    }
}


