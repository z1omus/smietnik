//virtual- możliwość nadpisania od rodzica
//jak w klasie jest virtual to można robić override
//jak jesteśmy w jednym pliku to nie robi znaczenia, czy klasa jest public czy nie
class Animal
{
    //w Kotlinie zamiast virtual jest open
    public virtual void MakeSound(){
        Console.WriteLine("Animal MakingSound");
    }
}

class Cat : Animal
{
    public override void MakeSound()
    {
        Console.WriteLine("Cat MakingSound");
    }
}

class Dog : Animal
{
    public override void MakeSound()
    {
        Console.WriteLine("Dog MakingSound");
    }
}

internal class Program
{
    public static void Main(string[] args)
    {
        Animal myAnimal = new Animal();
        Animal myDog = new Dog();
        //zmienna myDog jest typu Animal, ale obiekt przypisany jest typu Dog(), bo wszystkie klasy dziedziczą po klasie Animal
        Animal myCat = new Cat();
        myAnimal.MakeSound();
        myDog.MakeSound();
        myCat.MakeSound();
        
    }
}
