class Car
{
    //pola- zawsze obiekty muszą mieć te cechy
    public string brand;
    public string model;
    private int year = 2000;
    
    //metoda obiektu- każdy obiekt ma tą metodę, która nic nie zwraca, ale wyświetla coś
    public void DisplayInfo()
    {
        Console.WriteLine($"{brand} {model} - {year}");
    }
    //przeciążenie- konstruktory, które mają tą samą nazwę ALE RÓŻNE PARAMETRY
    //konstruktor - metoda klasy, która się nazywa tak samo jak klasa
    public Car()
    {
        this.brand = "fiat";
        this.model = "126p";
        this.year = 1970;
        //mogę ustawić wartość, bo jestem w danej klasie i do tego w konstruktorze
    }
    //konstruktor z parametrem
    public Car(string brand, string model, int year)
    {
        this.brand = brand;
        this.model = model;
        this.year = year;
    }
}


internal class Program
{
    public static void Main(string[] args)
    {
        Car car = new Car();
      // jeżeli konstruktor bez parametru
        car.DisplayInfo();
        //można wpisywać jakieś wartości tylko, jak jest public
        //car.year = 1995;
        car.DisplayInfo();
        //jeżeli metoda jest publiczna, to może wypisywać wartości, które są ustawione na private, bo one je otwiera w sobie
        Car car2 = new Car();
        car2.model = "500";
        car2.DisplayInfo();

    // jeżeli konstruktor z parametrem 
        Car car = new Car("car1", "car1-model", 1900);
        car.DisplayInfo();
        //można wpisywać jakieś wartości tylko, jak jest public
        //car.year = 1995;
        car.DisplayInfo();
        //jeżeli metoda jest publiczna, to może wypisywać wartości, które są ustawione na private, bo one je otwiera w sobie
        Car car2 = new Car("car2", "car2-model", 2900);
        car2.model = "500";
        car2.DisplayInfo();

      //przeciążenie
        Car car3 = new Car();
        car3.DisplayInfo();
        
    }
}
