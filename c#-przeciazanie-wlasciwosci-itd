class Animal
{
    public Animal(string name)
    {
        this.Name =  name;
    }
    public string Name { get; set; } = string.Empty;

    public void Eat()
    {
        Console.WriteLine($"{Name} Eating...");
    }
}

class Dog : Animal
{
    public Dog(string imie) : base(imie)
    {
        
    }
    public void Bark()
    {
        Console.WriteLine($"{Name} is barking...");
    }
}

class Cat : Animal
{
    public Cat(string imie) : base(imie)
    //base to odwołanie do konstruktora rodzica
    {
        
    }
    public void Meow()
    {
        Console.WriteLine($"{Name} is meowing...");
    }
}

internal class Program
{
    public static void Main(string[] args)
    {
        var reksio = new Dog("Azor");
        reksio.Name = "Reksio";
        reksio.Eat();
        reksio.Bark();

        var azor = new Dog("Reksio")
        {
            Name = "Azor",
        };
        //skrócona wersja, skrócenie wyjdzie dopiero, przy przekazywaniu n-tej wartości 
        azor.Eat();
        azor.Bark();
        
        var cloe = new Cat("Cloe");
        cloe.Eat();
        cloe.Meow();
    }
}
