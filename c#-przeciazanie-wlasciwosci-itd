//overloading
// w jednej klasie pojawia się ta sama metoda o różnych parametrach
class Calculator
{
    public int Add(int a, int b)
    {
        return a + b;
    }
    //rózna sygnatura, bo raz są 2 agrumenty, a potem 3
    public int Add(int a, int b, int c)
    {
        return a + b + c;
    }

    public double Add(double a, double b)
    {
        return a + b;
    }
}
internal class Program
{
    public static void Main(string[] args)
    {
        var cal =  new Calculator();
        Console.WriteLine(cal.Add(1, 2));
        Console.WriteLine(cal.Add(2.326, 24.1986));
        Console.WriteLine(cal.Add(134, 2356));
    }
}
