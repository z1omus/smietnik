class Car
{
    public string _brand;
    //_nazwa - prywatne
    //__nazwa - bardzo prywatne

    public string Brand
    {
        get { return _brand; }
        set { _brand = value; }
    }
    //to samo
    //public string Brand { get; set; }
    
    public string Color { get; } = "Pomarańczowy";
    //tylko do odczytu
    
    public void DisplayInfo()
    {
        Console.WriteLine($"{_brand}: ");
        Console.WriteLine($"brand: {Brand}");
        Console.WriteLine($"color: {Color}");
    }
}


internal class Program
{
    public static void Main(string[] args)
    {
        var car = new Car();
        car.DisplayInfo();
        car.Brand = "BMW";
        car.DisplayInfo();
    }
}
